# ---- Session & Security ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true  # SECURITY: Enable session encryption
SESSION_STORE=database  # SECURITY: Use database instead of cookie-based sessions

# ---- Security ----
# APP_ENV=production should be set before deploying
# ForceHTTPS middleware will redirect to HTTPS in production

# ---- Mail ----
MAIL_MAILER=log  # SECURITY: Log emails instead of sending in dev; configure real mailer for prod
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@tiarshop.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Cache (use database since redis PHP extension not available) ----
CACHE_STORE=database
CACHE_PREFIX=rostom_cache_

# ---- Queue ----
QUEUE_CONNECTION=database  # SECURITY: Use database queue in production

# ---- Optional: Redis config when extension available ----
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

